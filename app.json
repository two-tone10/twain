{
  "expo": {
    "name": "Keep",
    "slug": "twain",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lipurposefe.keep",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05060f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.lipurposefe.keep"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Keep",
      "themeColor": "#05060f",
      "backgroundColor": "#05060f"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#05060f"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.lipurposefe.keep.widgets",
          "groupIdentifier": "group.com.lipurposefe.keep",
          "widgets": [
            {
              "name": "TonightStar",
              "displayName": "Tonight’s star",
              "description": "One moment from your Keep list.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ],
      "expo-audio"
    ],
    "scheme": "keep",
    "backgroundColor": "#05060f",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae07bce4-7b06-4e5c-a174-c64e80195aa4"
      }
    },
    "owner": "two-tone10",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ae07bce4-7b06-4e5c-a174-c64e80195aa4",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
